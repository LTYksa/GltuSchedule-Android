<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络访问（课表导入：登录教务系统、抓取课表） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 读取网络状态（节假日同步前先判断有没有网，避免无网时空等超时） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 通知（Android 13+ 运行时权限，由通知模块使用） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确闹钟（上课提醒；Android 12+，部分机型需用户在设置中授权） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 一键同步课表到系统日历 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".GltuScheduleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GltuSchedule"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GltuSchedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小部件 Provider：标准（4x2，可拉伸） -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <!-- 桌面小部件 Provider：小规格（2x2） -->
        <receiver
            android:name=".widget.ScheduleWidgetProviderSmall"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_small" />
        </receiver>

        <!-- 桌面小部件 Provider：大规格（4x4） -->
        <receiver
            android:name=".widget.ScheduleWidgetProviderLarge"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_large" />
        </receiver>

        <!-- 小部件列表数据服务（RemoteViewsService） -->
        <service
            android:name=".widget.ScheduleWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 上课提醒闹钟接收器（由通知模块 ClassReminderScheduler 触发） -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <!-- 每日后台维护：自动同步节假日 + 补齐未来 30 天上课提醒 -->
        <receiver
            android:name=".notification.DailyMaintenanceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gltu.schedule.action.DAILY_MAINTENANCE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
